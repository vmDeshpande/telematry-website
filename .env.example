# Server Configuration
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=change-this-to-a-secure-random-string
TELEMETRY_ADMIN_PASSWORD=change-this-to-a-strong-password

# Database
MONGODB_URI=
MONGODB_DB_NAME=telemetry_collector

# Rate Limiting
TELEMETRY_RATE_LIMIT_MAX_REQUESTS=60
TELEMETRY_RATE_LIMIT_WINDOW_MS=60000
