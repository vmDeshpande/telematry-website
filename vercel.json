{
  "version": 2,
  "buildCommand": "npm run build",
  "env": {
    "SESSION_SECRET": {
      "description": "Secret key for session encryption",
      "value": "change-me-to-a-secure-random-string"
    },
    "TELEMETRY_ADMIN_PASSWORD": {
      "description": "Password for admin dashboard access",
      "value": "change-me-to-a-strong-password"
    },
    "TELEMETRY_DB_PATH": {
      "description": "Path to SQLite database file",
      "value": "/tmp/telemetry.db"
    },
    "TELEMETRY_RATE_LIMIT_MAX_REQUESTS": {
      "description": "Max requests per window",
      "value": "60"
    },
    "TELEMETRY_RATE_LIMIT_WINDOW_MS": {
      "description": "Rate limit window in milliseconds",
      "value": "60000"
    },
    "NODE_ENV": {
      "value": "production"
    },
    "PORT": {
      "value": "3000"
    }
  },
  "functions": {
    "server.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
